PORT=5000
NODE_ENV=production
ADMIN_KEY=your-secure-admin-key-here
# Comma-separated client origins allowed by CORS
CLIENT_ORIGIN=https://leftrightmedia.in,https://www.leftrightmedia.in
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Optional: Webhook URL (Discord / Slack) for instant notifications on new leads
DISCORD_WEBHOOK_URL=

