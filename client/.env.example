# API URL for the Express backend
# In local development: http://localhost:5000/api (or /api with Vite dev proxy)
# In production: https://api.leftrightmedia.in/api (or your Render service URL e.g. https://leftrightmedia-api.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Google Analytics GA4 Measurement ID (get from analytics.google.com)
# Leave blank in development — analytics will log to console instead
VITE_GA_MEASUREMENT_ID=
